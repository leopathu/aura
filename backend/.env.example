# Aura Backend Environment Variables
# Copy this file to .env and update with your values

# Project Settings
PROJECT_NAME="Aura AI Assistant"
VERSION="1.0.0"
DEBUG=True
PORT=8001

# Database Configuration
POSTGRES_USER=aura_user
POSTGRES_PASSWORD=aura_password_change_in_production
POSTGRES_DB=aura_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Security Keys
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption Key for API keys/credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-must-be-32-bytes-url-safe-base64

# CORS Origins (JSON array or single URL)
ALLOWED_ORIGINS=["http://localhost:3001", "http://127.0.0.1:3001"]

# LLM API Keys (Optional - Users can bring their own)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Google OAuth (for Gmail, Calendar, Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/callback/google

# Jira OAuth
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Redis (for task queue)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
