logs/
*.log

# Database
*.db
*.sqlite3
database/backups/*.sql.gz

# Docker
.dockerignore

# Alembic
backend/alembic/versions/*.py
!backend/alembic/versions/.gitkeep

# Test coverage
coverage.xml
.coverage

