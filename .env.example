# Aura Environment Configuration

# App
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Aura - Agentic Data & Knowledge Platform"

# Security (Change in production)
SECRET_KEY=aura-development-secret-key-change-in-production-min-32-chars
ENCRYPTION_KEY=b'G4_yZ0RkL1f_hXq3c8s-Uq7m8Lz4pQ1X3y2a5W9rT7A='
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
# For quick local standalone testing (default SQLite):
DATABASE_URL=sqlite+aiosqlite:///./aura.db
# For production PostgreSQL with pgvector:
# DATABASE_URL=postgresql+asyncpg://aura:aurasecret@localhost:5432/aura_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DIR=./storage
UPLOAD_MAX_SIZE_MB=50

# Query Safety Limits
SQL_MAX_ROWS=10000
SQL_DEFAULT_LIMIT=1000
SQL_QUERY_TIMEOUT_SECONDS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
